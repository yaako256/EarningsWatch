{
  "db_name": "PostgreSQL",
  "query": "\n      SELECT id, group_id, fingerprint, sent_at, status as \"status: NotifyStatus\"\n      FROM notify_history\n      WHERE ($1::notify_status IS NULL OR status = $1)\n      ORDER BY sent_at DESC LIMIT $2 OFFSET $3\n      ",
