{
  "db_name": "PostgreSQL",
  "query": "\n      SELECT id, group_id, fingerprint, sent_at, status as \"status: NotifyStatus\"\n      FROM notify_history\n      WHERE group_id = $1 AND ($2::notify_status IS NULL OR status = $2)\n      ORDER BY sent_at DESC LIMIT $3 OFFSET $4\n      ",
